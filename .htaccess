# Mafia-Born cPanel Cache Control
# Ensures players always get fresh JS/CSS/HTML after updates.
# Place this in the site root on cPanel (public_html or the domain folder).

<IfModule mod_headers.c>
  # JS, CSS, and HTML: always revalidate with the server
  <FilesMatch "\.(js|css|html)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  # Images / fonts: cache for 7 days (they rarely change)
  <FilesMatch "\.(png|jpg|jpeg|gif|webp|svg|ico|woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=604800, immutable"
  </FilesMatch>
</IfModule>

# Backend code, configs, data and docs run on Render and must never be served from this site
<FilesMatch "^(server|server-sanity-test|db|userDB|worldPersistence|version-bump|config\.example|config)\.js$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(json|md|yaml|yml|bat|ps1|service|env|log)$|^Procfile$">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)(node_modules|docs_archive|\.git|\.github|\.vscode)(/|$) - [F,L]
</IfModule>
